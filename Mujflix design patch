/**
 * MůjFlix — Design Patch v2
 * Používá MutationObserver + přímé inline styly na DOM elementech.
 * CSS třídy nestačí — app.js přidává inline styly a mf-chip-optimistic class.
 */
(function () {
  'use strict';

  // ── Barvy ────────────────────────────────────────────
  const ACCENT_BG     = 'rgba(10,132,255,0.16)';
  const ACCENT_BORDER = 'rgba(10,132,255,0.38)';
  const INACTIVE_BG   = 'transparent';
  const INACTIVE_BORDER = 'rgba(255,255,255,0.09)';
  const INACTIVE_COLOR  = 'rgba(255,255,255,0.42)';

  // ── Přepiš inline #mf-disco-override ────────────────
  function patchStyleTag() {
    const el = document.getElementById('mf-disco-override');
    if (el) {
      // Nahraď bílý active styl accentovým
      el.textContent = el.textContent
        .replace(/\.disco-nav-item\.active\s*\{[^}]*\}/g,
          `.disco-nav-item.active { color: #fff !important; background: ${ACCENT_BG} !important; border-color: ${ACCENT_BORDER} !important; box-shadow: 0 0 0 0.5px ${ACCENT_BORDER} !important; }`)
        .replace(/\.disco-header\s*\{[^}]*\}/g,
          `.disco-header { background: rgba(6,6,9,0.92) !important; backdrop-filter: blur(44px) saturate(1.8) !important; -webkit-backdrop-filter: blur(44px) saturate(1.8) !important; border-bottom: 0.5px solid rgba(255,255,255,0.06) !important; position: sticky !important; top: 0 !important; z-index: 20 !important; }`);
    }

    // Přepiš mf-disco-fx (app.js dynamický styl)
    const fx = document.getElementById('mf-disco-fx');
    if (fx) {
      fx.textContent = fx.textContent
        .replace(/\.disco-nav-item\.mf-chip-optimistic\s*\{[^}]*\}/g,
          `.disco-nav-item.mf-chip-optimistic { background: ${ACCENT_BG} !important; border-color: ${ACCENT_BORDER} !important; color: #fff !important; }`);
    }
  }

  // ── Nastav inline styly přímo na elementech ──────────
  function styleNavItems() {
    document.querySelectorAll('.disco-nav-item').forEach(el => {
      const isActive = el.classList.contains('active') || el.classList.contains('mf-chip-optimistic');
      el.style.setProperty('background',    isActive ? ACCENT_BG     : INACTIVE_BG,     'important');
      el.style.setProperty('border-color',  isActive ? ACCENT_BORDER : INACTIVE_BORDER, 'important');
      el.style.setProperty('color',         isActive ? '#fff'        : INACTIVE_COLOR,  'important');
      el.style.setProperty('border-width',  '0.5px', 'important');
      el.style.setProperty('border-style',  'solid', 'important');
    });
  }

  // ── Nastav sticky header ─────────────────────────────
  function styleHeader() {
    document.querySelectorAll('.disco-header').forEach(el => {
      el.style.setProperty('background',          'rgba(6,6,9,0.92)',            'important');
      el.style.setProperty('backdrop-filter',     'blur(44px) saturate(1.8)',    'important');
      el.style.setProperty('-webkit-backdrop-filter', 'blur(44px) saturate(1.8)', 'important');
      el.style.setProperty('border-bottom',       '0.5px solid rgba(255,255,255,0.06)', 'important');
      el.style.setProperty('position',            'sticky',  'important');
      el.style.setProperty('top',                 '0',       'important');
      el.style.setProperty('z-index',             '20',      'important');
    });
  }

  // ── Nastav primary tlačítka ──────────────────────────
  function stylePrimaryBtns() {
    document.querySelectorAll('.disco-hero-btn.primary').forEach(el => {
      el.style.setProperty('background',   'var(--accent)',                    'important');
      el.style.setProperty('color',        '#fff',                             'important');
      el.style.setProperty('box-shadow',   '0 4px 18px rgba(10,132,255,0.4)', 'important');
    });
  }

  // ── Spusť vše ────────────────────────────────────────
  function applyAll() {
    patchStyleTag();
    styleNavItems();
    styleHeader();
    stylePrimaryBtns();
  }

  // ── MutationObserver — sleduje změny tříd na nav itemech ─
  function startObserver() {
    const nav = document.getElementById('discoNav');
    if (!nav) return;

    new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.type === 'attributes' && m.attributeName === 'class') {
          // Reaguj ihned při změně třídy na nav itemu
          styleNavItems();
          return;
        }
      }
    }).observe(nav, { subtree: true, attributes: true, attributeFilter: ['class', 'style'] });
  }

  // ── Sleduj přidání mf-disco-fx stylu do <head> ───────
  function watchHead() {
    new MutationObserver(() => {
      const fx = document.getElementById('mf-disco-fx');
      if (fx && !fx._patched) {
        fx._patched = true;
        // Přepiš mf-chip-optimistic hned jak se styl přidá
        setTimeout(() => {
          fx.textContent = fx.textContent.replace(
            /\.disco-nav-item\.mf-chip-optimistic\s*\{[^}]*\}/g,
            `.disco-nav-item.mf-chip-optimistic { background: ${ACCENT_BG} !important; border-color: ${ACCENT_BORDER} !important; color: #fff !important; }`
          );
        }, 0);
      }
    }).observe(document.head, { childList: true });
  }

  // ── Init ─────────────────────────────────────────────
  function init() {
    applyAll();
    startObserver();
    watchHead();
    // Opakované jištění pro dynamicky přidávaný obsah
    [100, 300, 600, 1000, 2000].forEach(ms => setTimeout(applyAll, ms));
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  console.log('[MF Design Patch v2] ✓');
})();
